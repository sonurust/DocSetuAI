# ── Google AI / Gemini ───────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Google Cloud ─────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC=docsetuai-task-events

# ── Runtime mode ─────────────────────────────────────────────────
# "demo"  -> uses in-memory store + deterministic mock adapters (no external calls)
# "cloud" -> uses Firestore, Pub/Sub and Gemini via Google Cloud
RUNTIME_MODE=cloud

# ── API server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────
# Required in cloud mode. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=ecf303520b454f7f3c2c43b2adabc0b89e356a06d921a354acc78a8bd7d70a01

# ── Web app ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
