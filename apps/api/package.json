{
  "name": "@docsetuai/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@docsetuai/config": "workspace:*",
    "@docsetuai/types": "workspace:*",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@google/adk-devtools": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@docsetuai/types$": "<rootDir>/../../packages/types/src/index.ts",
      "^@docsetuai/config$": "<rootDir>/../../packages/config/src/index.ts"
    }
  }
}